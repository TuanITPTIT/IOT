                  "key": "sortBy",
                  "value": "timestamp"
                },
                {
                  "key": "sortDir",
                  "value": "desc"
                },
                {
                  "key": "keyword",
                  "value": ""
                },
                {
                  "key": "sensorType",
                  "value": ""
                }
              ]
            },
            "description": "Return paginated sensor history. Optional filters: keyword/query, sensorType, value, fromTime, toTime."
          },
          "response": []
        }
      ]
    },
