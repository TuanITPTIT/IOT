              "raw": "{{baseUrl}}/api/sensors/chart-data?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sensors",
                "chart-data"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Return latest grouped sensor points for dashboard chart."
          },
          "response": []
